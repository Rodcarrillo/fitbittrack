{
  "name": "fitbitrack",
  "version": "0.1.0",
  "private": true,
  "description": "FITBITRACK \u2014 your Fitbit data, reimagined.",
  "scripts": {
    "dev": "node scripts/build.mjs --serve",
    "build": "node scripts/build.mjs",
    "build:google": "VITE_DATA_PROVIDER=google node scripts/build.mjs",
    "build:pythonanywhere": "VITE_DATA_PROVIDER=google node scripts/build.mjs && rm -rf pythonanywhere/static && mkdir -p pythonanywhere/static && cp dist/index.html dist/favicon.* dist/*.png dist/manifest.webmanifest pythonanywhere/static/",
    "typecheck": "tsc --noEmit",
    "server": "node --env-file=server/.env server/index.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@netlify/blobs": "^8.1.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "esbuild": "^0.24.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
